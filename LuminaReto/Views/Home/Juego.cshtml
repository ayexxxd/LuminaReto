@{
    ViewData["Title"] = "Juego";
    Layout = "_Layout";
}

<div class="juego-page">
    <div class="game-frame-wrapper">
        <div class="game-frame-inner">
            <div class="frame-corner tl"></div>
            <div class="frame-corner tr"></div>
            <div class="frame-corner bl"></div>
            <div class="frame-corner br"></div>
            <iframe
                src="/PruebaJuego2/index.html?v=70"
                class="unity-iframe"
                scrolling="no"
                allowfullscreen>
            </iframe>
        </div>
    </div>
</div>

<style>
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: #0a0a0f;
    }

    .juego-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 60px); /* adjust 60px to your navbar height */
        background: #0a0a0f;
        padding: 1.5rem;
        box-sizing: border-box;
    }

    .game-frame-wrapper {
        width: 100%;
        max-width: 960px;
    }

    .game-frame-inner {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        background: #000;

        /* chamfered corners via clip-path */
        clip-path: polygon(
            12px 0%, calc(100% - 12px) 0%,
            100% 12px, 100% calc(100% - 12px),
            calc(100% - 12px) 100%, 12px 100%,
            0% calc(100% - 12px), 0% 12px
        );

        /* purple accent border rendered as outline via box-shadow */
        outline: 1.5px solid #7c5cbf;
        outline-offset: 0px;
    }

    /* Decorative corner brackets — drawn outside the clip region */
    .game-frame-wrapper {
        position: relative;
    }

    .frame-corner {
        position: absolute;
        width: 20px;
        height: 20px;
        z-index: 2;
        pointer-events: none;
    }

    .frame-corner.tl { top: -2px;  left: -2px;  border-top: 2px solid #c084fc; border-left:  2px solid #c084fc; }
    .frame-corner.tr { top: -2px;  right: -2px; border-top: 2px solid #c084fc; border-right: 2px solid #c084fc; }
    .frame-corner.bl { bottom: -2px; left: -2px;  border-bottom: 2px solid #c084fc; border-left:  2px solid #c084fc; }
    .frame-corner.br { bottom: -2px; right: -2px; border-bottom: 2px solid #c084fc; border-right: 2px solid #c084fc; }

    .unity-iframe {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
    }

    @@media (max-width: 600px) {
        .juego-page {
            padding: 0.5rem;
            min-height: calc(100vh - 56px);
        }
    }
</style>
