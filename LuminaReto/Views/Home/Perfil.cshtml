@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/siteXimena.css" asp-append-version="true" />
}

<div class="cont-principal">
    <h1 class=" fw-bold">Mi Perfil</h1>
    <p class="pagina-sub">Gestiona tu información personal y sigue tu progreso.</p>

    <div class="dos-columnas">

        
        <div class="col-izq">

    <div class="tarjeta">
    <form class="formulario-perfil" method="post" action="/Perfil/Perfil">
        <div class="perfil-header">
            <div class="circulo-foto">
                <img src="@(ViewData["FotoUrl"]?.ToString() ?? "/imagenes/perfilfoto.png")" alt="Foto de perfil" class="foto-perfil">
            </div>
            <div class="pinfo">
                <h3>@ViewData["NombreCliente"]</h3>
                <p class="departamento">🏢 @ViewData["DepaCliente"]</p>
                <span class="meta-nivel">¡A por el nivel 10! 🎯</span>
            </div>
        </div>
        @if (TempData["Confirmacion"] != null)
        {
            var conf = TempData["Confirmacion"] as Perfil.Models.Confirmacion;
            <div id="alertaExito" class="alerta @conf.Tipo mostrar">
                <span>@conf.Mensaje</span>
            </div>
        }
        
        <div class="formulario">
            <div class="field">
                <div  class="pagina-subt">Nombre Completo</div>
                <input type="text" name="nombre" class="form-control" required id="exampleInputNombre1" aria-describedby="nombreHelp" placeholder="Ejemplo: Juan Pérez" value="@ViewData["NombreCliente"]" @(ViewData["Editable"] as bool? == true ? "" : "readonly") >
            </div>

            <div class="field">
                <div  class="pagina-subt">Correo electrónico</div>
                <input type="email" name="correo" class="form-control" required id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Ejemplo: juanperez@whirlpool.com" value="@ViewData["CorreoCliente"]"@(ViewData["Editable"] as bool? == true ? "" : "readonly") />
            </div>

            <div class="field">
                <div  class="pagina-subt">Departamento</div>
                <input type="text" name="departamento" class="form-control" list="listaDepartamentos" required id="exampleInputDepartamento1" aria-describedby="depaHelp" placeholder="Ejemplo: Marketing" value="@ViewData["DepaCliente"]" readonly>                <datalist id="listaDepartamentos">@foreach (var depa in (List<string>)ViewData["ListaDepartamentos"])
                {
                    <option value="@depa"></option>
                }
                </datalist>
            </div>

            <div class="field">
                <div class="pagina-subt">Fecha de registro</div>
                <input type="text" class="form-control" readonly value="@ViewData["FechaRegistro"]" />
            </div>
        </div>
        <input type="hidden" name="fechaRegistro" value="@ViewData["FechaRegistro"]" />
        <button type="submit"  class="btn btn-primary btn-sm formulario-perfil">Guardar cambios</button>
        <button type="submit" name="modo" value="editar" class="btn btn-secondary btn-sm formulario-perfil">Editar</button>
    </form>
</div>

@{
                var tokensVal      = Convert.ToInt32(ViewData["Tokens"]      ?? 0);
                var rachaVal       = Convert.ToInt32(ViewData["Racha"]       ?? 0);
                var formulariosVal = Convert.ToInt32(ViewData["Formularios"] ?? 0);
            }
            
            <div class="tarjeta">
                <p class="sec-titulo">  📊 Estadísticas</p>
                <div class="stats-grid">
                    <div class="stat-item">
                        <div class="stat-ico ico-t">💰</div>
                        <div class="stat-data">
                            <span class="stat-lbl">Tokens ganados</span>
                            <span class="stat-num">@tokensVal.ToString("N0")</span>
                            <span class="stat-sub">Total acumulado</span>
                        </div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-ico ico-r">📅</div>
                        <div class="stat-data">
                            <span class="stat-lbl">Racha máxima</span>
                            <span class="stat-num">@rachaVal.ToString("N0") días</span>
                            <span class="stat-sub">¡Sigue así!</span>
                        </div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-ico ico-f">📋</div>
                        <div class="stat-data">
                            <span class="stat-lbl">Formularios totales</span>
                            <span class="stat-num">@formulariosVal.ToString("N0")</span>
                            <span class="stat-sub">Completados</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        
        <div class="col-der">
            <div class="tarjeta">

                <div class="logros-header">
                    <p class="sec-titulo" style="margin-bottom:0"> 🏆 Mis Logros</p>
                </div>

                
                <p class="sub-seccion">Insignias destacadas</p>
                <div class="dest-grid">
                    <div class="ins-dest">
                        <div class="medalla m-oro">⭐</div>
                        <span class="badge-dest">Destacada</span>
                        <p>Estrella de Producción</p>
                    </div>
                    <div class="ins-dest">
                        <div class="medalla m-bronce">📝</div>
                        <span class="badge-dest">Destacada</span>
                        <p>Maestro del Formulario</p>
                    </div>
                    <div class="ins-dest">
                        <div class="medalla m-dorado">🏅</div>
                        <span class="badge-dest">Destacada</span>
                        <p>Racha Legendaria</p>
                    </div>
                </div>

            
                <p class="sub-seccion">Catálogo de insignias</p>
                <div class="cat-grid">
                    <div class="ins-cat">
                        <div class="cat-med c-azul">✓</div>
                        <div class="chk-verde">✔</div>
                        <p>Primera Misión</p>
                    </div>
                    <div class="ins-cat">
                        <div class="cat-med c-amarillo">🏆</div>
                        <div class="chk-verde">✔</div>
                        <p>Coleccionista</p>
                    </div>
                    <div class="ins-cat">
                        <div class="cat-med c-gris">🔒</div>
                        <p>Mentor de Equipo</p>
                    </div>
                    <div class="ins-cat">
                        <div class="cat-med c-gris">🔒</div>
                        <p>Maestro del Juego Nv.10</p>
                    </div>
                    <div class="ins-cat">
                        <div class="cat-med c-gris">🔒</div>
                        <p>Maestro del Juego Nv.3</p>
                    </div>
                    <div class="ins-cat">
                        <div class="cat-med c-gris">🔒</div>
                        <p>Mentor de Equipo Nv.5</p>
                    </div>
                </div>


            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var alerta = document.getElementById("alertaExito");
            if (alerta) {
                
                setTimeout(function() {
                    alerta.classList.remove("mostrar");
                }, 5000);
            }
        });
    </script>
}