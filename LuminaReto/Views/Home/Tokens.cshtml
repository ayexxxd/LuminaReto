@model TokenViewModel
@{
    ViewData["Title"] = "Tokens";
}

@section Styles {
    <link rel="stylesheet" href="~/css/siteTokens.css" asp-append-version="true" />
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="MESSAGE MESSAGE-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="tokens-page">
    <h1 class="tokens-title">Mis Tokens</h1>
    <section class="tokens-resumen"><!-- Resumen OOOOOOOOOOOOOOOOOOOOO)O)O)O)O)O)O)O)O0o0o0o0o0o0o0o0o0o0o0o-->
        <article class="token-card card-primary">
            <div class="token-card-head">
                <p>Balance Total</p>
                <img src="~/imagenes/WTokens.png" alt="Icono" />
            </div>

            <h2>@Model.WhirlTokens</h2>
            <span>Tokens disponibles</span>
        </article>

        <article class="token-card card-positive">
            <div class="token-card-head">
                <p>Whirl Tokens</p>
                <img src="~/imagenes/Racha.png" alt="Icono" />
            </div>

            <h2>+@Model.GanadosMes</h2>
            <span>↑Obtenidos este mes</span>
        </article>

        <article class="token-card card-goal">
            <div class="token-card-head">
                <p>Última Recompensa</p>
                <img src="~/imagenes/Nivel.png" alt="Icono" />
            </div>

            <h2>@Model.UltimaRecompensa</h2>
            <span>¡Disfruta!</span>
        </article>
    </section>

    <section class="panel-tokens chart-panel"><!-- Historial OOOOOOOOOOOOOOOOOOOOO)O)O)O)O)O)O)O)O0o0o0o0o0o0o0o0o0o0o0o-->
        <h3>Historial de Tokens</h3>
        <iframe width="1140" height="300" src="@Model.TokensGraphUrl" frameborder="0" style="border:0" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>

    <div class="bottom-dashboard dashboard-split">
        <section class="panel-tokens transactions-panel"><!-- Transacciones OOOOOOOOOOOOOOOOOOOOO)O)O)O)O)O)O)O)O0o0o0o0o0o0o0o0o0o0o0o-->
            <div class="transactions-head">
                <h3>Transacciones Recientes</h3>
                <div class="transactions-filters">
                    <form method="get" asp-controller="Tokens" asp-action="Index">
                        <div class="transactions-filters">
                            <select name="DateFilter" class="form-select" onchange="this.form.submit()">
                                <option value="todas" selected="@(Model.DateFilter == "todas")">Filtro por fecha</option>
                                <option value="hoy" selected="@(Model.DateFilter == "hoy")">Hoy</option>
                                <option value="semana" selected="@(Model.DateFilter == "semana")">Esta semana</option>
                                <option value="mes" selected="@(Model.DateFilter == "mes")">Este mes</option>
                            </select>
                        
                            <select name="TypeFilter" class="form-select" onchange="this.form.submit()">
                                <option value="todas" selected="@(Model.TypeFilter == "todas")">Filtro por tipo</option>
                                <option value="ganadas" selected="@(Model.TypeFilter == "ganadas")">Adquiridas</option>
                                <option value="gastadas" selected="@(Model.TypeFilter == "gastadas")">Gastadas</option>
                            </select>
                        </div>
                    </form>
                </div>
            </div>
            <div class="transactions-list" id="listaTransacciones">
                @foreach (var t in Model.ListaTransacciones)
                {
                    <article class="transaction-item">
                        <div class="tx-main">
                            <div class="tx-icon @(t.Monto > 0 ? "tx-positive" : "tx-negative")">
                                @if (t.Monto > 0)
                                {
                                    <img src="~/imagenes/trend.png" alt="Ganada" />
                                }
                                else
                                {
                                    <img src="~/imagenes/downtrend.png" alt="Gastada" />}
                            </div>

                            <div class="tx-text">
                                <h4>@t.Descripcion</h4>
                                <p>@t.Fecha.Substring(4, 12)</p><!--el valor de r.Fecha es algo como Sun May 05 2026 14:48:00 GMT-0500 y entonces solo quiero mostrar May 05 2026-->
                            </div>
                        </div>

                        <div class="@(t.Monto > 0 ? "amount-positive" : "amount-negative")">@(t.Monto > 0 ? "+" : "")@t.Monto.ToString("N0")</div>
                    </article>
                }
            </div>
        </section>

        <section class="panel-tokens rewards-panel"><!-- Recompensas OOOOOOOOOOOOOOOOOOOOO)O)O)O)O)O)O)O)O0o0o0o0o0o0o0o0o0o0o0o-->
            <h3>Tienda</h3>
            <div class="rewards-window">
                <div class="rewards-grid">
                    @foreach (var r in Model.ListaRecompensas)
                    {
                        <article class="reward-card @(r.PuedeCanjear ? "reward-active" : "reward-disabled")">

                            <div class="reward-icon">
                                <img src="~/imagenes/@r.Imagen" alt="Icono" />
                            </div>

                            <h4>@r.NombreRecompensa</h4>
                            <div class="reward-price">@r.Costo.ToString("N0") Tokens</div>
                            @if (r.PuedeCanjear)
                            {
                                <button type="button" class="btn-red btn-canjear"
                                        data-id="@r.IdRecompensa"
                                        data-nombre="@r.NombreRecompensa"
                                        data-imagen="@r.Imagen"
                                        data-costo="@r.Costo.ToString("N0")"
                                        data-tokens="@Model.WhirlTokens">
                                    Canjear
                                </button>
                            }
                            else
                            {
                                <button class="btn-disabled" disabled>Necesitas @r.TokensFaltantes.ToString("N0") más</button>
                            }
                        </article>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

<img src="" alt="Confeti" class="confetti" />

<!-- Modal de confirmación de canje -->
<div id="modalCanje" class="modal-canje" style="display:none;">
    <div class="modal-canje-overlay"></div>
    <div class="modal-canje-content">
        <h3>Confirmar Canje</h3>
        <div class="modal-canje-body">
            <div class="modal-reward-icon">
                <img id="modalImg" src="" alt="Recompensa" />
            </div>
            <p class="modal-reward-name" id="modalNombre"></p>
            <p class="modal-reward-cost">Costo: <span id="modalCosto"></span> Tokens</p>
            <p class="modal-reward-balance">Tus Tokens: <span id="modalTokens"></span></p>
        </div>
        <form method="post" asp-controller="Tokens" asp-action="Canjear">
            <input type="hidden" name="recompensaId" id="modalRecompensaId" />
            <div class="modal-canje-actions">
                <button type="button" class="btn-cancelar" id="btnCancelarCanje">Cancelar</button>
                <button type="submit" class="btn-confirmar">Confirmar compra</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById('modalCanje');
        const btns = document.querySelectorAll('.btn-canjear');
        const btnCancelar = document.getElementById('btnCancelarCanje');

        btns.forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('modalRecompensaId').value = btn.dataset.id;
                document.getElementById('modalNombre').textContent = btn.dataset.nombre;
                document.getElementById('modalImg').src = '/imagenes/' + btn.dataset.imagen;
                document.getElementById('modalCosto').textContent = btn.dataset.costo;
                document.getElementById('modalTokens').textContent = btn.dataset.tokens;
                modal.style.display = 'flex';
            });
        });

        btnCancelar.addEventListener('click', () => {
            modal.style.display = 'none';
        });

        modal.querySelector('.modal-canje-overlay').addEventListener('click', () => {
            modal.style.display = 'none';
        });
    </script>
}