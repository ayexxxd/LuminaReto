@model TokenViewModel
@{
    ViewData["Title"] = "Tokens";
}

@section Styles {
    <link rel="stylesheet" href="~/css/siteTokens.css" asp-append-version="true" />
}

<div class="tokens-page">
    <h1 class="tokens-title">Mis Tokens</h1>

    <section class="tokens-resumen">
        <article class="token-card card-primary">
            <div class="token-card-head">
                <p>Balance Total</p>
                <img src="~/imagenes/WTokens.png" alt="Icono" />
            </div>
            <h2>@Model.WhirlTokens</h2>
            <span>Tokens disponibles</span>
        </article>

        <article class="token-card card-positive">
            <div class="token-card-head">
                <p>Ganados este mes</p>
                <img src="~/imagenes/Nivel.png" alt="Icono" />
            </div>
            <h2>+@Model.GanadosMes</h2>
            <span>↑ cálculo automático</span>
        </article>

        <article class="token-card card-goal">
            <div class="token-card-head">
                <p>Próxima Recompensa</p>
                <img src="~/imagenes/christmas.png" alt="Icono" />
            </div>
            <h2>@Model.ProximaRecompensa</h2>
            <span>tokens de meta</span>
        </article>
    </section>

    <section class="tokens-progress panel-tokens">
        <div class="progress-head">
            <h3>Progreso hacia la próxima recompensa</h3>
            <strong>@Model.WhirlTokens / @Model.TargetProgreso</strong>
        </div>

        <div class="progress-track">
            <div class="progress-fill" style="width:@(Model.PorcentajeProgreso)%;"></div>
        </div>
        <p class="progress-meta">Te faltan <strong>@Model.RestantesProgreso</strong> tokens para la siguiente recompensa.</p>
    </section>

    <section class="panel-tokens chart-panel">
        <h3>Historial de Tokens</h3>
        <h6>(Ultimos 7 días)</h6>
        <div class="chart-container">
            <canvas id="tokensChart"></canvas>
            <img src ="~/imagenes/placeholdergraph.png" alt="Gráfico" class="chart-icon" />
        </div>
    </section>

    <section class="panel-tokens">
        <div class="transactions-head">
                    <h3>Transacciones Recientes</h3>
                    <div class="transactions-filters">
                        <select id="filterReciente" class="form-select">
                            <h2>Reciente</h2>
                            <option value="todas">Todas</option>
                            <option value="hoy">Hoy</option>
                            <option value="semana">Esta semana</option>
                            <option value="mes">Este mes</option>
                        </select>

                        <select id="filterTipo" class="form-select">
                            <h2>Tipo</h2>
                            <option value="todas">Todas</option>
                            <option value="ganadas">Ganadas</option>
                            <option value="gastadas">Gastadas</option>
                        </select>
                    </div>
                </div>

        <div class="transactions-list" id="listaTransacciones">
                    @foreach (var t in Model.ListaTransacciones)
                    {
                        <article class="transaction-item" data-date="@t.Fecha" data-amount="@t.Monto">
                            <div class="tx-main">
                                <span class="tx-icon">
                                    <img src="@t.Imagen" alt="Icono" />
                                </span>
                                <div>
                                    <h4>@t.Descripcion</h4>
                                    <p>@t.Fecha</p>
                                </div>
                            </div>
                            <strong>@t.Monto</strong>
                        </article>
                    }
        </div>
    </section>

    <section class="panel-tokens rewards-panel">
        <h3>Recompensas Disponibles</h3>
        <div class="rewards-window">
            <div class="rewards-grid">
                @foreach (var r in Model.ListaRecompensas)
                {
                    <article class="reward-card">
                        <div class="reward-icon"><img src="@r.Imagen" alt="Icono"/></div>
                        <h4>@r.NombreRecompensa</h4>
                        <div class="reward-price">@r.Costo</div>
                        <form method="post" action="/Tokens/Canjear">
                            <input type="hidden" name="recompensaId" value="@r.Id" />
                            <button class="btn-red">Canjear</button>
                        </form>
                    </article>
                }
            </div>
        </div>
    </section>

    
</div>

 